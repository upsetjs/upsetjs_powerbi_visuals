{
  "name": "@upsetjs/powerbi_visuals",
  "description": "UpSet.js is a re-implementation of UpSetR to create interactive set visualizations for more than three sets",
  "version": "1.10.12",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Samuel Gratzl",
    "email": "sam@sgratzl.com",
    "url": "https://wwww.sgratzl.com"
  },
  "homepage": "https://github.com/upsetjs/upsetjs_powerbi_visuals",
  "bugs": {
    "url": "https://github.com/upsetjs/upsetjs_powerbi_visuals/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgratzl/upsetjs_powerbi_visuals.git"
  },
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start --target es6",
    "test": "echo no tests",
    "cert": "pbiviz --create-cert",
    "build:preview": "shx mv pbiviz.json pbiviz.bak.json && shx cp pbiviz_preview.json pbiviz.json && pbiviz package && shx mv dist/upSetJS* dist/upsetjs_preview.pbiviz && shx rm pbiviz.json && shx mv pbiviz.bak.json pbiviz.json",
    "build": "shx rm -rf dist && npm run build:preview && pbiviz package && shx cp dist/upSetJS* dist/upsetjs.pbiviz",
    "lint": "tslint -c tslint.json -p tsconfig.json",
    "alint": "npm run eslint && npm run prettier",
    "fix": "npm run eslint:fix && npm run prettier:write",
    "prettier:impl": "prettier \"*.{md,json,yml}\" .eslintrc.js .prettierrc.js \"{src,scripts,.github}/**\"",
    "prettier:write": "npm run prettier:impl -- --write",
    "prettier": "npm run prettier:impl -- --check",
    "eslint": "eslint src --ext .ts,.tsx",
    "eslint:fix": "npm run eslint -- --fix",
    "posttest": "npm run lint",
    "release": "release-it --disable-metrics",
    "package": "npm run build"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.24.7",
    "@upsetjs/bundle": "~1.11.0",
    "core-js": "^3.37.1",
    "powerbi-models": "^1.15.2",
    "powerbi-visuals-api": "~4.7.0",
    "powerbi-visuals-utils-dataviewutils": "^6.1.0"
  },
  "devDependencies": {
    "@types/webpack": "5.28.5",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-powerbi-visuals": "^0.8.1",
    "eslint-plugin-prettier": "^5.1.3",
    "powerbi-visuals-tools": "^5.5.0",
    "prettier": "^3.3.2",
    "release-it": "^17.3.0",
    "shx": "^0.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5",
    "webpack": "^5.92.1"
  }
}
