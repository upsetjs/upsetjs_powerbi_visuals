{
  "name": "@upsetjs/powerbi_visuals",
  "description": "UpSet.js is a re-implementation of UpSetR to create interactive set visualizations for more than three sets",
  "version": "0.6.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Samuel Gratzl",
    "email": "sam@sgratzl.com",
    "url": "https://wwww.sgratzl.com"
  },
  "homepage": "https://github.com/upsetjs/upsetjs_powerbi_visuals",
  "bugs": {
    "url": "https://github.com/upsetjs/upsetjs_powerbi_visuals/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sgratzl/upsetjs_powerbi_visuals.git"
  },
  "scripts": {
    "pbiviz": "pbiviz",
    "start": "pbiviz start",
    "test": "echo no tests",
    "build": "rimraf dist && pbiviz package",
    "postbuild": "cp dist/upSetJS* dist/upsetjs.pbiviz",
    "lint": "npm run eslint && npm run prettier:check",
    "fix": "npm run eslint:fix && npm run prettier:write",
    "prettier": "prettier \"*.{md,json,yml}\" .eslintrc.js .prettierrc \"{src,scripts,.github}/**\"",
    "prettier:write": "npm run prettier -- --write",
    "prettier:check": "npm run prettier -- --check",
    "black": "black --target-version=py37 upsetjs_jupyter_widget setup.py setupbase.py",
    "eslint": "eslint src --ext .ts,.tsx",
    "eslint:fix": "npm run eslint -- --fix",
    "posttest": "npm run lint",
    "release:major": "release-it --disable-metrics major",
    "release:minor": "release-it --disable-metrics minor",
    "release:patch": "release-it --disable-metrics patch",
    "package": "npm run build"
  },
  "dependencies": {
    "@babel/runtime": "^7.9.2",
    "@babel/runtime-corejs3": "^7.9.2",
    "@upsetjs/bundle": "~0.6.0",
    "core-js": "^3.6.5",
    "powerbi-visuals-api": "~2.6.2",
    "powerbi-visuals-utils-dataviewutils": "~2.2.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/eslint-plugin-tslint": "^2.28.0",
    "@typescript-eslint/parser": "^2.28.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-prettier": "^3.1.3",
    "powerbi-visuals-tools": "^3.1.12",
    "powerbi-visuals-webpack-plugin": "2.2.4",
    "prettier": "^2.0.4",
    "release-it": "^13.5.4",
    "rimraf": "^3.0.2",
    "ts-loader": "^7.0.0",
    "tslint": "^6.1.1",
    "tslint-microsoft-contrib": "^6.2.0",
    "typescript": "^3.8.3"
  }
}
