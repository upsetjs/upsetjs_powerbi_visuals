{
  "dataRoles": [
    {
      "name": "elements",
      "displayName": "Elements",
      "description": "exactly one grouping representing the list of elements that are synced",
      "kind": "Grouping",
      "preferredTypes": [
        {
          "text": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "sets",
      "displayName": "Sets",
      "description": "one or more grouping or measures where each is interpreted as a set, a trueish value in row i is interpreted that the corresponding element i is part of this set",
      "kind": "GroupingOrMeasure",
      "preferredTypes": [
        {
          "bool": true
        },
        {
          "integer": true
        }
      ]
    },
    {
      "name": "attributes",
      "displayName": "Attributes",
      "description": "zero or more numerical measures which are used to render boxplots",
      "kind": "Measure",
      "preferredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        }
      ]
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "elements": { "max": 1 }
        }
      ],
      "categorical": {
        "categories": {
          "for": { "in": "elements" },
          "dataReductionAlgorithm": {
            "window": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [{ "bind": { "to": "sets" } }, { "bind": { "to": "attributes" } }]
        }
      }
    }
  ],
  "suppressDefaultTitle": true,
  "objects": {
    "license": {
      "displayName": "License",
      "objectCategory": 1,
      "properties": {
        "code": {
          "displayName": "Code",
          "type": { "text": true }
        },
        "info": {
          "displayName": "Info",
          "type": { "text": true }
        },
        "contact": {
          "displayName": "Contact",
          "type": { "text": true }
        }
      }
    },

    "combinations": {
      "displayName": "Set Combinations",
      "objectCategory": 1,
      "properties": {
        "type": {
          "displayName": "Generation Mode",
          "type": {
            "enumeration": [
              {
                "displayName": "Set Intersections",
                "value": "intersection"
              },
              {
                "displayName": "Set Unions",
                "value": "union"
              },
              {
                "displayName": "Distinct Set Intersections",
                "value": "distinctIntersection"
              }
            ]
          }
        },
        "min": {
          "displayName": "Minimum Degree",
          "type": {
            "numeric": true
          }
        },
        "max": {
          "displayName": "Maximum Degree",
          "type": {
            "numeric": true
          }
        },
        "empty": {
          "displayName": "Show Empty Combinations",
          "type": {
            "bool": true
          }
        },
        "limit": {
          "displayName": "Limit to Top N Combinations",
          "type": {
            "numeric": true
          }
        },
        "order": {
          "displayName": "Order Combinations By",
          "type": {
            "enumeration": [
              { "value": "name", "displayName": "1. Name" },
              { "value": "cardinality,name", "displayName": "1. Cardinality 2. Name" },
              { "value": "cardinality,degree,name", "displayName": "1. Cardinality 2. Degree 3. Name" },
              { "value": "degree,name", "displayName": "1. Degree 2. Name" },
              { "value": "degree,cardinality,name", "displayName": "1. Degree 2. Cardinality 3. Name" },
              { "value": "group,name", "displayName": "1. Set Group 2. Name" },
              { "value": "group,cardinality,name", "displayName": "1. Set Group 2. Cardinality 3. Name" },
              { "value": "group,degree,name", "displayName": "1. Set Group 2. Degree 3. Name" },
              {
                "value": "group,degree,cardinality,name",
                "displayName": "1. Set Group 2. Degree 3. Cardinality 4. Name"
              }
            ]
          }
        }
      }
    },
    "theme": {
      "displayName": "Theme",
      "objectCategory": 1,
      "properties": {
        "theme": {
          "displayName": "Theme",
          "type": {
            "enumeration": [
              {
                "displayName": "Dark",
                "value": "dark"
              },
              {
                "displayName": "Light",
                "value": "light"
              },
              {
                "displayName": "Vega",
                "value": "vega"
              }
            ]
          }
        },
        "selectionColor": {
          "displayName": "Selection Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "alternatingBackgroundColor": {
          "displayName": "Alternating Background Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "color": {
          "displayName": "Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "textColor": {
          "displayName": "Text Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "hoverHintColor": {
          "displayName": "Hover Hint Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "notMemberColor": {
          "displayName": "Not Member Color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "style": {
      "displayName": "Style",
      "properties": {
        "numericScale": {
          "displayName": "Scale",
          "type": {
            "enumeration": [
              { "displayName": "Linear Scale", "value": "linear" },
              { "displayName": "Log Scale", "value": "log" }
            ]
          }
        },
        "setName": {
          "displayName": "Set Axis Name",
          "type": {
            "text": true
          }
        },
        "combinationName": {
          "displayName": "Combination Axis Name",
          "type": {
            "text": true
          }
        },
        "setNameAxisOffset": {
          "displayName": "Set Axis Offset",
          "type": {
            "numeric": true
          }
        },
        "combinationNameAxisOffset": {
          "displayName": "Combination Axis Offset",
          "type": {
            "numeric": true
          }
        }
      }
    }
  },
  "supportsHighlight": true
}
