      "preferredTypes": [
        {
          "numeric": true
        },
        {
          "integer": true
        },
        {
          "text": true
        }
      ]
    },
    {
      "name": "counts",
      "displayNameKey": "Role_Counts",
      "descriptionKey": "Role_Counts_Desc",
      "kind": "Measure",
      "preferredTypes": [{ "numeric": true }, { "integer": true }]
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [{ "elements": { "max": 1 } }, { "counts": { "max": 1 } }],
      "categorical": {
        "categories": {
          "for": { "in": "elements" },
          "dataReductionAlgorithm": {
            "window": { "count": 30000 }
          }
        },
        "values": {
          "select": [
            { "bind": { "to": "sets" } },
            { "bind": { "to": "counts" } }
          ]
        }
      }
    }
  ],
