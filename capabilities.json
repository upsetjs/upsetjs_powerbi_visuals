{
  "dataRoles": [
    {
      "name": "elements",
      "displayNameKey": "Role_Elements",
      "descriptionKey": "Role_Elements_Desc",
      "kind": "Grouping",
      "preferredTypes": [{ "text": true }, { "integer": true }]
    },
    {
      "name": "sets",
      "displayNameKey": "Role_Sets",
      "descriptionKey": "Role_Sets_Desc",
